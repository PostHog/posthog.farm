{
  "name": "posthog-farm",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch:hedgehogs": "node scripts/fetch-hedgehogs.ts",
    "predev": "node scripts/fetch-hedgehogs.ts --if-missing",
    "dev": "vite",
    "prebuild": "node scripts/fetch-hedgehogs.ts",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json && tsc -p worker/tsconfig.json",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "wrangler": "^4.151.0"
  },
  "dependencies": {
    "posthog-js": "^1.438.10"
  }
}
