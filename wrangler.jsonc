{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "posthog-farm",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Daily at 05:00 UTC the Worker calls its own Workers Builds deploy hook, so the farm
  // rebuilds with a fresh roster (see the scheduled handler in worker/index.ts).
  "triggers": { "crons": ["0 5 * * *"] },
  "routes": [
    { "pattern": "posthog.farm", "custom_domain": true },
    { "pattern": "www.posthog.farm", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // the Worker runs first on every request so it can redirect www.posthog.farm
    "run_worker_first": true
  },
  // The Barn: a single SQLite-backed Durable Object. It's the source of truth for
  // hedgehog XP and for the "one snack per IP per day" rule. Durable Objects process
  // requests one at a time, so the check-and-insert is atomic (no double-feeding races,
  // unlike KV which is eventually consistent).
  "durable_objects": {
    "bindings": [{ "name": "BARN", "class_name": "Barn" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Barn"] }],
  // Cloudflare's Rate Limiting binding: cheap edge-side burst protection so nobody
  // can hammer the Barn with feed requests. The daily limit lives in the Barn.
  "ratelimits": [
    {
      "name": "FEED_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
  // Secrets (set in the dashboard or with `wrangler secret put`):
  //   IP_SALT: random string used to hash visitor IPs, so we never store raw IPs
  //   DEPLOY_HOOK_URL: the Workers Builds deploy hook the daily cron calls
}
